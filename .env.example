# .env.example

# Gemini API Key (required for answer generation)
GEMINI_API_KEY=

# Privacy/consent flags
ENABLE_PRIVACY_CONSENT=true

# Tracker local storage key (optional override)
TRACKER_STORAGE_KEY=apply_workspace_tracker

# Add additional environment variables as needed for local development.

# ── Google chrome settings ───────────────────────
# Go to https://chrome.google.com/webstore/developer/dashboard to get your publisher ID and extension ID.

# CWS_PUBLISHER_ID=
# CWS_EXTENSION_ID=
# GOOGLE_CHROME_API_KEY=