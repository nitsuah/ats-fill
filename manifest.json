{
  "manifest_version": 3,
  "name": "ats-fill",
  "version": "1.0.1",
  "description": "Local-first ATS form-filling assistant. Save your profile once, review answers, and fill forms with your own Gemini key.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://remotive.com/*",
    "https://www.arbeitnow.com/*",
    "https://www.themuse.com/*",
    "https://api.adzuna.com/*",
    "https://data.usajobs.gov/*",
    "https://remoteok.com/*",
    "https://jobicy.com/*",
    "https://www.workingnomads.com/*",
    "https://www.reed.co.uk/*",
    "https://jooble.org/*",
    "https://hn.algolia.com/*",
    "https://weworkremotely.com/*",
    "https://remote.co/*",
    "https://api.linkedin.com/*",
    "https://*.greenhouse.io/*",
    "https://*.ashbyhq.com/*",
    "https://*.lever.co/*",
    "https://www.linkedin.com/*",
    "https://*.workday.com/*",
    "https://*.icims.com/*",
    "https://*.jobvite.com/*",
    "https://*.circle.com/*",
    "https://*.phenompeople.com/*",
    "https://hackajob.com/*",
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ats-fill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.ashbyhq.com/*",
        "https://*.lever.co/*",
        "https://www.linkedin.com/jobs/*",
        "https://*.workday.com/*",
        "https://*.icims.com/*",
        "https://*.jobvite.com/*",
        "https://*.circle.com/*",
        "https://*.phenompeople.com/*",
        "https://*/careers",
        "https://*/careers/*",
        "https://*/jobs",
        "https://*/jobs/*",
        "https://*/job/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/field-map.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
